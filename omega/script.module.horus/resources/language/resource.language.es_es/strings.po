# --- APK download menu and EspaKodi addons menu (ported from 1.3.5) ---
# NOTE: in 1.3.5 these labels used 30048-30052, which here are already the history
# context menu and the engine download error. They are renumbered to 30082+

msgctxt "#30053"
msgid "Choose the folder to save %s"
msgstr "Elige la carpeta donde guardar %s"

msgctxt "#30054"
msgid "Downloading %s..."
msgstr "Descargando %s..."

msgctxt "#30055"
msgid "APK downloaded to:\n%s\n\nTo install it:\n1) Open a file manager on your device (on Fire TV, the \"Downloader\" app; on mobile, \"Files\" or \"My Files\").\n2) Go to that folder and tap the APK.\n3) If Android asks for permission to install unknown apps, grant it to THAT app (the file manager), not to Kodi."
msgstr "APK descargado en:\n%s\n\nPara instalarlo:\n1) Abre un gestor de archivos de tu dispositivo (en Fire TV, la app \"Downloader\"; en móvil, \"Archivos\" o \"Mis archivos\").\n2) Entra en la carpeta indicada y pulsa el APK.\n3) Si Android pide permiso para instalar apps de origen desconocido, concédeselo a ESA app (el gestor de archivos), no a Kodi."

msgctxt "#30056"
msgid "%s already exists in that folder.\n\nDo you want to download it again and overwrite it?"
msgstr "%s ya existe en esa carpeta.\n\n¿Quieres descargarlo de nuevo y sobrescribirlo?"

msgctxt "#30057"
msgid "Download cancelled"
msgstr "Descarga cancelada"

msgctxt "#30058"
msgid "%s could not be downloaded.\n\n%s"
msgstr "No se ha podido descargar %s.\n\n%s"

msgctxt "#30060"
msgid "%s\n\nThis file is an Android installer (APK), so it can only be installed on Android devices (Fire TV, Android TV, phones...).\n\nIt has been saved to:\n%s"
msgstr "%s\n\nEste archivo es un instalador de Android (APK), así que solo se puede instalar en dispositivos Android (Fire TV, Android TV, móviles...).\n\nSe ha guardado en:\n%s"

msgctxt "#30061"
msgid "Install now"
msgstr "Instalar ahora"

msgctxt "#30062"
msgid "Install manually (any device)"
msgstr "Instalar a mano (cualquier dispositivo)"

msgctxt "#30063"
msgid "Open unknown sources settings"
msgstr "Abrir ajustes de orígenes desconocidos"

msgctxt "#30064"
msgid "Close"
msgstr "Cerrar"

msgctxt "#30065"
msgid "EKHorus: installation"
msgstr "EKHorus: instalación"

msgctxt "#30066"
msgid "Preparing the APK for the installer..."
msgstr "Preparando el APK para el instalador..."

msgctxt "#30067"
msgid "Cannot write to this folder:\n%s\n\nChoose another one."
msgstr "No se puede escribir en esta carpeta:\n%s\n\nElige otra."

msgctxt "#30068"
msgid "Install now (root / Kodi as a system app)"
msgstr "Instalar ahora (root / Kodi como app de sistema)"

msgctxt "#30069"
msgid "APK installed successfully."
msgstr "APK instalado correctamente."

msgctxt "#30070"
msgid "It could not be installed automatically: this requires root or Kodi running as a system app.\n\nInstall it manually from a file manager instead."
msgstr "No se ha podido instalar automáticamente: hace falta root o que Kodi sea una app de sistema.\n\nInstálalo a mano desde un gestor de archivos."

msgctxt "#30071"
msgid "%s is already being downloaded"
msgstr "Ya se está descargando %s"

msgctxt "#30072"
msgid "Could not write to disk. The device may be out of free space."
msgstr "No se ha podido escribir en el disco. Puede que no quede espacio libre en el dispositivo."

msgctxt "#30073"
msgid "%s could not be prepared for the installer.\n\n%s"
msgstr "No se ha podido preparar %s para el instalador.\n\n%s"

msgctxt "#30074"
msgid "[COLOR yellow]32 or 64 bits?[/COLOR] - press to find out which one to download"
msgstr "[COLOR yellow]¿32 o 64 bits?[/COLOR] - pulsa para saber cuál bajar"

msgctxt "#30075"
msgid "Some apps on this list come in two versions, 32-bit (armeabi-v7a) and 64-bit (arm64-v8a).\n\nThe 32-bit one is for the Fire TV Stick and most TV boxes, and nearly every 64-bit device installs it too without any issue; only a few newer ones, mostly phones, have dropped 32-bit apps. The 64-bit one is for those.\n\nIf in doubt, try the 32-bit one. If the system won't install it, your device is 64-bit only, so download the 64-bit one.\n\nMore apps and help:\n- EspaKodi on Telegram https://t.me/espakodi\n- https://espakodi.github.io/apk/"
msgstr "Mucho Udyat: algunas apps de esta lista vienen en dos versiones, de 32 bits (armeabi-v7a) y de 64 bits (arm64-v8a).\n\nLa de 32 bits es la del Fire TV Stick y la mayoría de TV box, y casi todos los aparatos de 64 bits también la instalan sin problema; solo algunos muy modernos, sobre todo móviles, han dejado de admitir apps de 32 bits. Para esos está la de 64 bits.\n\nSi dudas, prueba con la de 32 bits. Si el sistema no te deja instalarla, tu aparato es solo de 64 bits, así que bájate la de 64.\n\nMás apps y ayuda:\n- Telegram de EspaKodi https://t.me/espakodi\n- https://espakodi.github.io/apk/"

msgctxt "#30076"
msgid "Download again"
msgstr "Descargar de nuevo"

msgctxt "#30077"
msgid "Use the existing one"
msgstr "Usar el que ya está"

msgctxt "#30078"
msgid "The copy of %s you already had is damaged or incomplete.\n\nIt will be downloaded again."
msgstr "El %s que ya tenías está dañado o incompleto.\n\nSe va a descargar de nuevo."

msgctxt "#30079"
msgid "%s finished downloading, but the file is damaged or incomplete.\n\nPlease try again."
msgstr "%s ha terminado de descargarse, pero el archivo está dañado o incompleto.\n\nInténtalo de nuevo."

msgctxt "#30080"
msgid "%s downloaded correctly, but it could not be saved into the chosen folder.\n\nTry another folder."
msgstr "%s se ha descargado bien, pero no se ha podido guardar en la carpeta elegida.\n\nPrueba con otra carpeta."

msgctxt "#30081"
msgid "EspaKodi Addons"
msgstr "EspaKodi Addons"

msgctxt "#30082"
msgid "Download APKs"
msgstr "Descargar APKs"

msgctxt "#30083"
msgid "AceStream (32-bit)"
msgstr "AceStream (32 bits)"

msgctxt "#30084"
msgid "AceServe (32-bit)"
msgstr "AceServe (32 bits)"

msgctxt "#30085"
msgid "VLC (32-bit)"
msgstr "VLC (32 bits)"

msgctxt "#30086"
msgid "EspaKodi Warp (32-bit)"
msgstr "EspaKodi Warp (32 bits)"

# --- 1.6.0: per-engine port and detection of which one answers ---
# NOTE: 30059 has been skipped since 1.5.0, do not reuse it.

msgctxt "#30087"
msgid "AceServe engine port (empty = same as AceStream)"
msgstr "Puerto de AceServe (vacío = el de AceStream)"

msgctxt "#30088"
msgid "%s is answering on port %s. Check the Ace Engine setting."
msgstr "Contesta %s en el puerto %s. Revisa el ajuste Motor ace."

msgctxt "#30089"
msgid "Something that is not the ace engine is listening on port %s.\n\nAceServe pins that port and does not start while it is taken. Close the other application, or change the port in the Control panel."
msgstr "En el puerto %s hay algo escuchando que no es el motor ace.\n\nAceServe fija ese puerto y no arranca mientras esté ocupado. Cierra la otra aplicación o cambia el puerto en el Cuadro de mandos."

msgctxt "#30090"
msgid "Opening the engine. Come back to Kodi once it has started."
msgstr "Abriendo el motor. Vuelve a Kodi cuando haya arrancado."

msgctxt "#30091"
msgid "The ace engine could not be opened.\n\nIf you do not have it installed, you will find AceStream and AceServe in the Download APKs menu."
msgstr "No se ha podido abrir el motor ace.\n\nSi no lo tienes instalado, en el menú Descargar APKs tienes AceStream y AceServe."

# --- 1.6.0: control panel ---

msgctxt "#30092"
msgid "Control panel"
msgstr "Cuadro de mandos"

msgctxt "#30093"
msgid "Choose the engine, change its address and port, switch the external player on or off, and see live which engine is answering."
msgstr "Elige el motor, cambia su dirección y su puerto, enciende o apaga el reproductor externo y mira en vivo qué motor está contestando."

msgctxt "#30094"
msgid "EKHorus guide"
msgstr "Guía de EKHorus"

msgctxt "#30095"
msgid "The complete guide to EKHorus, AceStream and AceServe: read it here or open it in your browser."
msgstr "La guía completa de EKHorus, AceStream y AceServe: léela aquí mismo o ábrela en el navegador."
# --- 1.6.0: menu with icons, Universo EspaKodi and classic interface ---

msgctxt "#30096"
msgid "EspaKodi Universe"
msgstr "Universo EspaKodi"

msgctxt "#30097"
msgid "AceStream, AceServe, VLC, EspaKodi, VPNs and more as APK files, for Fire TV, TV boxes and phones, without leaving Kodi."
msgstr "AceStream, AceServe, VLC, EspaKodi, VPN y más en APK, para Fire TV, TV box y móvil, sin salir de Kodi."

msgctxt "#30098"
msgid "Every add-on in the EspaKodi ecosystem."
msgstr "Todos los addons del ecosistema EspaKodi."

msgctxt "#30099"
msgid "Paste an acestream identifier, a magnet link or the address of a torrent and play it right away."
msgstr "Pega un identificador acestream, un enlace magnet o la dirección de un torrent y reprodúcelo al momento."

msgctxt "#30100"
msgid "Search channels by name, or open a list of links from an address."
msgstr "Busca canales por su nombre, o abre una lista de enlaces desde una dirección."

msgctxt "#30101"
msgid "Everything you have opened, wherever it came from: channels, searches, pasted identifiers, the phone page and other add-ons. The last 300."
msgstr "Todo lo que has abierto, venga de donde venga: canales, búsquedas, identificadores, la página del móvil y otros addons. Los 300 últimos."

msgctxt "#30102"
msgid "Stops the AceStream engine on this machine, whether EKHorus started it or not."
msgstr "Detiene el motor AceStream de este equipo, lo haya arrancado EKHorus o no."

msgctxt "#30103"
msgid "The add-on settings, the same ones the control panel changes."
msgstr "Los ajustes del addon, los mismos que cambia el cuadro de mandos."

msgctxt "#30104"
msgid "Links to the whole EspaKodi ecosystem."
msgstr "Enlaces a todo el ecosistema EspaKodi."

msgctxt "#30105"
msgid "Classic interface (plain Kodi lists)"
msgstr "Interfaz clásica (listas de Kodi)"

msgctxt "#30106"
msgid "The window could not be opened. Falling back to the usual list."
msgstr "No se ha podido abrir la ventana. Se abre la lista de siempre."

msgctxt "#30107"
msgid "Engine"
msgstr "Motor"

msgctxt "#30108"
msgid "Playback"
msgstr "Reproducción"

msgctxt "#30109"
msgid "Interface"
msgstr "Interfaz"

msgctxt "#30110"
msgid "Choose the file to play"
msgstr "Elige el fichero que quieres ver"

msgctxt "#30115"
msgid "Channels"
msgstr "Canales"

msgctxt "#30116"
msgid "Live TV channels, by category, country and language, with the state of every link."
msgstr "Canales de televisión en directo, por categoría, país e idioma, con el estado de cada enlace."

msgctxt "#30117"
msgid "Show adult categories"
msgstr "Mostrar categorías de adultos"

msgctxt "#30118"
msgid "Refresh the channel list after (hours, 0 = never)"
msgstr "Caducar la lista de canales a las (horas, 0 = nunca)"

msgctxt "#30119"
msgid "Also search the channel list"
msgstr "Buscar también en la lista de canales"

msgctxt "#30120"
msgid "QR with the engine address instead of the acestream:// link"
msgstr "QR con la dirección del motor en vez del enlace acestream://"

msgctxt "#30121"
msgid "Audio transcoding"
msgstr "Transcodificar el audio"

msgctxt "#30122"
msgid "Do not touch it"
msgstr "No tocarlo"

msgctxt "#30123"
msgid "AC3 to stereo"
msgstr "AC3 a estéreo"

msgctxt "#30124"
msgid "Everything to AAC"
msgstr "Todo a AAC"

msgctxt "#30125"
msgid "Watch on your phone"
msgstr "Ver en el móvil"

msgctxt "#30126"
msgid "The whole channel list on a phone, a tablet or a PC. You can watch a channel right there, in the browser with nothing installed, or send it to this Kodi from the page, which works as a remote control."
msgstr "La lista entera de canales en el móvil, la tablet o el PC. Puedes ver un canal ahí mismo, en el navegador y sin instalar nada, o enviarlo a este Kodi desde la página, que hace de mando a distancia."

msgctxt "#30127"
msgid "Port of the web interface"
msgstr "Puerto de la interfaz web"

msgctxt "#30128"
msgid "Experimental"
msgstr "Experimental"

msgctxt "#30129"
msgid "What is still being tried out: the web page for your phone, and taking the channels to the TV section of the main menu."
msgstr "Lo que todavía está en pruebas: la página web para el móvil y llevar los canales a la sección TV del menú principal."

# --- 1.9.0: History and My favourites ---
# NOTE: 30130-30132 were the 2.0 notice, taken out. Kodi keeps an addon's strings until it
# restarts, so reusing those ids would paint the old notice in these rows. Do not reuse them.

msgctxt "#30133"
msgid "My favourites"
msgstr "Mis favoritos"

msgctxt "#30134"
msgid "The links you keep from the History or from Channels, under the name you give them."
msgstr "Los enlaces que guardas desde el Historial o desde Canales, con el nombre que tú les pongas."

msgctxt "#30135"
msgid "Add to My favourites"
msgstr "Añadir a Mis favoritos"

msgctxt "#30136"
msgid "Remove from My favourites"
msgstr "Quitar de Mis favoritos"

msgctxt "#30137"
msgid "Rename"
msgstr "Renombrar"

msgctxt "#30138"
msgid "Added to My favourites"
msgstr "Añadido a Mis favoritos"

msgctxt "#30139"
msgid "Name of the favourite"
msgstr "Nombre del favorito"

msgctxt "#30140"
msgid "Pre-buffering is slow (seeds: %s). If it does not start, try another link."
msgstr "La precarga va lenta (semillas: %s). Si no arranca, prueba otro enlace."

msgctxt "#30141"
msgid "The link has not started in %s seconds. Try another one."
msgstr "El enlace no ha arrancado en %s segundos. Prueba con otro."

# --- 1.9.0: the other links of a channel ---

msgctxt "#30142"
msgid "This link does not start. Trying another one of the same channel (%s of %s)."
msgstr "Este enlace no arranca. Probando otro del mismo canal (%s de %s)."

msgctxt "#30143"
msgid "None of the %s links of the channel has started."
msgstr "No ha arrancado ninguno de los %s enlaces del canal."

msgctxt "#30144"
msgid "link %s of %s"
msgstr "enlace %s de %s"

# --- 1.9.0: keeping and taking out from the lists ---

msgctxt "#30145"
msgid "Removed from My favourites"
msgstr "Quitado de Mis favoritos"

msgctxt "#30146"
msgid "Already in My favourites"
msgstr "Ya está en Mis favoritos"

msgctxt "#30147"
msgid "No longer in My favourites"
msgstr "Ya no está en Mis favoritos"

# --- 1.9.0: the slow notice on the last link of a channel ---

msgctxt "#30148"
msgid "Pre-buffering is slow (seeds: %s). This is the channel's last link."
msgstr "La precarga va lenta (semillas: %s). Es el último enlace del canal."

# --- 1.9.0: opening magnets and .torrent with Elementum ---

msgctxt "#30149"
msgid "Open with Elementum"
msgstr "Abrir con Elementum"

msgctxt "#30150"
msgid "Elementum is not installed. It can be installed from EspaKodi Addons."
msgstr "Elementum no está instalado. Se instala desde EspaKodi Addons."

msgctxt "#30151"
msgid "Open with"
msgstr "Abrir con"

msgctxt "#30152"
msgid "The AceStream engine"
msgstr "El motor AceStream"

# --- 1.9.0: the engine on another device, and starting it without playing ---

msgctxt "#30153"
msgid "No engine answers at %s:%s.\n\nStart it on that device or check the address in the Control panel."
msgstr "No responde ningún motor en %s:%s.\n\nArráncalo en ese aparato o revisa la dirección en el Cuadro de mandos."

msgctxt "#30154"
msgid "Start Acestream engine"
msgstr "Arrancar motor Acestream"

msgctxt "#30155"
msgid "Starts the engine on this machine without playing anything. Channels and the phone page need it."
msgstr "Arranca el motor de este equipo sin reproducir nada. Hace falta para abrir Canales y para la página del móvil."

msgctxt "#30156"
msgid "Acestream engine running"
msgstr "Motor Acestream en marcha"

msgctxt "#30157"
msgid "This device has little memory, so the page is better opened from a phone or tablet on the same wifi. In a browser on this device it sometimes works, but with the browser in front Android may close Kodi to free memory, and the page with it, or the video may cut out."
msgstr "Este aparato tiene poca memoria, así que es mejor abrir la página desde el móvil o la tablet conectados a la misma wifi. En un navegador de este aparato a veces va bien, pero con el navegador delante Android puede cerrar Kodi para liberar memoria, y con él la página, o cortarse el vídeo."

# --- 1.9.0: typing with the remote or with the phone ---

msgctxt "#30158"
msgid "Type with"
msgstr "Escribir con"

msgctxt "#30159"
msgid "Ask every time"
msgstr "Preguntar siempre"

msgctxt "#30160"
msgid "The TV remote"
msgstr "El mando de la tele"

msgctxt "#30161"
msgid "The phone (with loiolink technology)"
msgstr "El móvil (con la tecnología de loiolink)"

msgctxt "#30162"
msgid "Open %s"
msgstr "Abrir %s"

msgctxt "#30163"
msgid "Opens %s, the app that works as the engine on this device, without playing anything. Channels and the phone page need it."
msgstr "Abre %s, la aplicación que hace de motor en este aparato, sin reproducir nada. Hace falta para abrir Canales y para la página del móvil."

msgctxt "#30164"
msgid "EspaKodi GTA Soundtrack (background music)"
msgstr "EspaKodi GTA Soundtrack (música ambiente)"

msgctxt "#30165"
msgid "Address of the track (empty, the one it comes with)"
msgstr "Dirección de la pista (vacío, la que trae)"

msgctxt "#30166"
msgid "You can turn it off in Settings > Interface"
msgstr "Puedes quitarla en Ajustes > Interfaz"

msgctxt "#30167"
msgid "Save in %s"
msgstr "Guardar en %s"

msgctxt "#30168"
msgid "Choose another folder"
msgstr "Elegir otra carpeta"

msgctxt "#30169"
msgid "Take the channels to the TV section"
msgstr "Llevar los canales a la sección TV"

msgctxt "#30170"
msgid "Puts the channels you choose in the TV section of the main menu, the one with live channels: My favourites, the ones in Channels or AceServe's list, in groups and with their logos. Pressing one plays it through EKHorus, as from here. It installs IPTV Simple if it is missing, does not touch the lists you already have and, if the TV entry is hidden, offers to show it. Press here again to update them or take them away."
msgstr "Pone en la sección TV del menú principal, la de los canales en directo, los canales que elijas: Mis favoritos, los de Canales o la lista de AceServe, por grupos y con sus logos. Al pulsar uno se abre por EKHorus, como desde aquí. Si falta IPTV Simple lo instala, no toca las listas que ya tengas y, si la entrada TV está oculta, te ofrece mostrarla. Pulsa aquí otra vez para actualizarlos o quitarlos."

msgctxt "#30171"
msgid "Save in the History every AceStream link played in Kodi"
msgstr "Guardar en el historial todos los enlaces de AceStream que se reproducen en Kodi"

msgctxt "#30172"
msgid "Move up"
msgstr "Subir"

msgctxt "#30173"
msgid "Move down"
msgstr "Bajar"

msgctxt "#30174"
msgid "Move to the top"
msgstr "Mover al principio"

msgctxt "#30175"
msgid "Engine found on port %s"
msgstr "Motor encontrado en el puerto %s"

msgctxt "#30176"
msgid "Close engine"
msgstr "Cerrar motor"

msgctxt "#30177"
msgid "An engine is answering on this device. Android lets no app close another, so this takes you to where you can stop it yourself."
msgstr "Hay un motor contestando en este aparato. Android no deja que una app cierre a otra, así que esto te lleva a donde puedes pararlo tú."

msgctxt "#30178"
msgid " Looking for the engine on other ports of this device..."
msgstr " Buscando el motor en otros puertos de este aparato..."
