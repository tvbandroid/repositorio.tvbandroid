<?xml version="1.0" encoding="utf-8"?>
<window type="dialog">
    <!-- It points at the X: when the window loads the list is still empty and takes no
         focus. onInit moves it as soon as there are sections. -->
    <defaultcontrol>100</defaultcontrol>
    <controls>

        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true" fallback="special://home/addons/script.module.horus/icon.png">special://home/addons/script.module.horus/fanart.jpg</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="F60F1216">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>

        <!-- Header. Nothing clickable goes past x=1824: on a curved-screen phone the
             last 96 px of the skin space already fall on the curve. -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>104</height>
            <texture colordiffuse="EE0B0F14">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>104</top><width>1920</width><height>2</height>
            <texture colordiffuse="FFD9A520">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="image">
            <left>96</left><top>24</top><width>56</width><height>56</height>
            <aspectratio>keep</aspectratio>
            <texture>special://home/addons/script.module.horus/resources/media/icono_aces_horus.png</texture>
        </control>
        <control type="label">
            <left>168</left><top>26</top><width>700</width><height>52</height>
            <font>font37</font>
            <textcolor>FFF0F0F0</textcolor>
            <aligny>center</aligny>
            <label>[COLOR FFFFB70F][B]EK[/B][/COLOR]Horus[COLOR FF8A97A5]   ·   [/COLOR]Guía</label>
        </control>

        <!-- Index of sections -->
        <control type="list" id="200">
            <left>96</left><top>136</top><width>620</width><height>816</height>
            <orientation>vertical</orientation>
            <pagecontrol>-1</pagecontrol>
            <scrolltime tween="cubic" easing="out">240</scrolltime>
            <onup>103</onup>
            <ondown>200</ondown>
            <onleft>200</onleft>
            <onright>301</onright>
            <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
            <animation effect="slide" start="-40,0" end="0,0" time="320" tween="cubic" easing="out">WindowOpen</animation>

            <itemlayout width="620" height="72">
                <control type="image">
                    <left>20</left><top>16</top><width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FF8A97A5">$INFO[ListItem.Property(g_icono)]</texture>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="label">
                    <left>72</left><top>0</top><width>456</width><height>72</height>
                    <font>font13</font>
                    <textcolor>FFD8DDE3</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="label">
                    <left>536</left><top>0</top><width>64</width><height>72</height>
                    <font>font12</font>
                    <textcolor>FF5D6875</textcolor>
                    <align>right</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Property(g_pista)]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="image">
                    <left>84</left><top>35</top><width>14</width><height>2</height>
                    <texture colordiffuse="FF5D6875">special://home/addons/script.module.horus/resources/media/white.png</texture>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),entrada)</visible>
                </control>
                <control type="label">
                    <left>110</left><top>0</top><width>490</width><height>72</height>
                    <font>font12</font>
                    <textcolor>FFA8B2BE</textcolor>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),entrada)</visible>
                </control>
            </itemlayout>

            <focusedlayout width="620" height="72">
                <control type="image">
                    <left>0</left><top>4</top><width>620</width><height>64</height>
                    <texture border="18" colordiffuse="3AD9A520">special://home/addons/script.module.horus/resources/media/pill.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>18</top><width>6</width><height>36</height>
                    <texture border="3" colordiffuse="FFFFB70F">special://home/addons/script.module.horus/resources/media/pill.png</texture>
                </control>
                <control type="image">
                    <left>20</left><top>16</top><width>40</width><height>40</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="FFFFB70F">$INFO[ListItem.Property(g_icono)]</texture>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="label">
                    <left>72</left><top>0</top><width>456</width><height>72</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="label">
                    <left>536</left><top>0</top><width>64</width><height>72</height>
                    <font>font12</font>
                    <textcolor>FFB8C2CE</textcolor>
                    <align>right</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Property(g_pista)]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),seccion)</visible>
                </control>
                <control type="image">
                    <left>84</left><top>35</top><width>14</width><height>2</height>
                    <texture colordiffuse="FFFFB70F">special://home/addons/script.module.horus/resources/media/white.png</texture>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),entrada)</visible>
                </control>
                <control type="label">
                    <left>110</left><top>0</top><width>490</width><height>72</height>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(g_tipo),entrada)</visible>
                </control>
            </focusedlayout>
        </control>

        <!-- Text of the chosen section -->
        <control type="image">
            <left>756</left><top>136</top><width>1068</width><height>816</height>
            <texture border="18" colordiffuse="B2080B0F">special://home/addons/script.module.horus/resources/media/pill.png</texture>
        </control>
        <control type="label">
            <left>788</left><top>160</top><width>1000</width><height>60</height>
            <font>font36_title</font>
            <textcolor>FFF0F0F0</textcolor>
            <wrapmultiline>true</wrapmultiline>
            <label>$INFO[Window.Property(g_titulo)]</label>
        </control>
        <control type="image">
            <left>788</left><top>230</top><width>1000</width><height>2</height>
            <texture colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="textbox">
            <left>788</left><top>252</top><width>976</width><height>660</height>
            <font>font13</font>
            <textcolor>FFD8DDE3</textcolor>
            <pagecontrol>300</pagecontrol>
            <label>$INFO[Window.Property(g_cuerpo)]</label>
        </control>
        <control type="scrollbar" id="300">
            <left>1776</left><top>252</top><width>20</width><height>660</height>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <texturesliderbackground border="8" colordiffuse="18FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturesliderbackground>
            <texturesliderbar border="8" colordiffuse="99D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturesliderbar>
            <texturesliderbarfocus border="8" colordiffuse="FFD9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturesliderbarfocus>
            <textureslidernib>special://home/addons/script.module.horus/resources/media/transparent.png</textureslidernib>
            <textureslidernibfocus>special://home/addons/script.module.horus/resources/media/transparent.png</textureslidernibfocus>
            <onleft>200</onleft>
            <onright>300</onright>
            <onup>300</onup>
            <ondown>300</ondown>
        </control>

        <!-- A textbox takes no focus, so what turns the pages is this invisible button
             on top of the text. It is the same trick DialogTextViewer uses. -->
        <control type="button" id="301">
            <left>788</left><top>252</top><width>976</width><height>660</height>
            <label></label>
            <texturefocus>special://home/addons/script.module.horus/resources/media/transparent.png</texturefocus>
            <texturenofocus>special://home/addons/script.module.horus/resources/media/transparent.png</texturenofocus>
            <!-- Tapping the text turns the page, which is what a finger reader expects -->
            <onclick>PageDown(300)</onclick>
            <onup>PageUp(300)</onup>
            <ondown>PageDown(300)</ondown>
            <onleft>200</onleft>
            <onright>301</onright>
        </control>
        <!-- That the text holds the focus is shown by framing it, not by a loose mark -->
        <control type="image">
            <left>756</left><top>136</top><width>1068</width><height>816</height>
            <texture border="18" colordiffuse="FFD9A520">special://home/addons/script.module.horus/resources/media/pill_borde.png</texture>
            <visible>Control.HasFocus(301)</visible>
        </control>

        <control type="image">
            <left>0</left><top>968</top><width>1920</width><height>2</height>
            <texture colordiffuse="33D9A520">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="label">
            <left>96</left><top>986</top><width>1728</width><height>44</height>
            <font>font12</font>
            <textcolor>FF8A97A5</textcolor>
            <aligny>center</aligny>
            <label>[B]OK[/B] despliega    ·    [B]Derecha[/B] para leer y pasar páginas    ·    [B]Atrás[/B] cierra</label>
            <visible>!Control.HasFocus(301)</visible>
        </control>
        <control type="label">
            <left>96</left><top>986</top><width>1728</width><height>44</height>
            <font>font12</font>
            <textcolor>FF8A97A5</textcolor>
            <aligny>center</aligny>
            <label>[B]Arriba[/B] y [B]Abajo[/B] pasan página    ·    desliza el dedo sobre el texto    ·    [B]Izquierda[/B] vuelve al índice</label>
            <visible>Control.HasFocus(301)</visible>
        </control>

        <control type="button" id="103">
            <left>1408</left><top>22</top><width>304</width><height>60</height>
            <font>font13</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFB8C2CE</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <label>Abrir en la web</label>
            <texturefocus border="18" colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturefocus>
            <texturenofocus border="18" colordiffuse="14FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturenofocus>
            <onup>103</onup>
            <ondown>200</ondown>
            <onleft>103</onleft>
            <onright>100</onright>
        </control>

        <!-- The X goes last on purpose: if Kodi could not focus the default control,
             the focus is taken by the first one that does accept it. -->
        <control type="button" id="100">
            <left>1740</left><top>22</top><width>84</width><height>60</height>
            <font>font32</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FF8A97A5</textcolor>
            <focusedcolor>FFFFB70F</focusedcolor>
            <label>X</label>
            <texturefocus border="18" colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturefocus>
            <texturenofocus border="18" colordiffuse="14FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturenofocus>
            <onup>100</onup>
            <ondown>200</ondown>
            <onleft>103</onleft>
            <onright>100</onright>
        </control>

    </controls>
</window>
