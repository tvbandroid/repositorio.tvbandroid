            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <!-- Until its text first changes, the textbox never tells the bar how long it is, and
                 Kodi starts the bar at 100 items in pages of 10. A panel empty from the start
                 showed a bar with nothing to scroll. -->
            <visible>!String.IsEmpty(Container(200).ListItem.Property(f_plot))</visible>
            <texturesliderbackground border="8" colordiffuse="18FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturesliderbackground>
            <texturesliderbar border="8" colordiffuse="99D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturesliderbar>
