            <texture border="18" colordiffuse="B2080B0F">special://home/addons/script.module.horus/resources/media/pill.png</texture>
        </control>
        <!-- One line. Kodi does not keep a wrapping label inside its height, so a second line
             was drawn over the rule and the text. A longer name ends in dots, and the screens
             that can carry one start the text below with it whole. -->
