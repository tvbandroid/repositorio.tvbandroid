<?xml version="1.0" encoding="utf-8"?>
<window type="dialog">
    <!-- It points at the X and not at the list: when the window loads the list is still
         empty and takes no focus, so Kodi left an error in the log on every opening. The
         focus is set by onInit as soon as there are rows. -->
