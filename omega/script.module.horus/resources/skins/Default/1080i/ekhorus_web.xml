<?xml version="1.0" encoding="utf-8"?>
<window type="dialog">
    <defaultcontrol>101</defaultcontrol>
    <controls>

        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true" fallback="special://home/addons/script.module.horus/icon.png">special://home/addons/script.module.horus/fanart.jpg</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="F60F1216">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>

        <!-- Header. Nothing clickable goes past x=1824: on a curved-screen phone the
             last 96 px of the skin space already fall on the curve. -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>104</height>
            <texture colordiffuse="EE0B0F14">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>104</top><width>1920</width><height>2</height>
            <texture colordiffuse="FFD9A520">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="image">
            <left>96</left><top>24</top><width>56</width><height>56</height>
            <aspectratio>keep</aspectratio>
            <texture>special://home/addons/script.module.horus/resources/media/movil.png</texture>
        </control>
        <control type="label">
            <left>168</left><top>26</top><width>1100</width><height>52</height>
            <font>font37</font>
            <textcolor>FFF0F0F0</textcolor>
            <aligny>center</aligny>
            <label>[COLOR FFFFB70F][B]EK[/B][/COLOR]Horus[COLOR FF8A97A5]   ·   [/COLOR]Ver en el móvil</label>
        </control>

        <!-- The QR, which is the whole point of this screen -->
        <control type="image">
            <left>128</left><top>172</top><width>556</width><height>620</height>
            <texture border="18" colordiffuse="B2080B0F">special://home/addons/script.module.horus/resources/media/pill.png</texture>
        </control>
        <control type="image">
            <left>168</left><top>212</top><width>476</width><height>476</height>
            <texture colordiffuse="FFFFFFFF">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="image">
            <left>184</left><top>228</top><width>444</width><height>444</height>
            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window.Property(w_qr)]</texture>
        </control>
        <control type="label">
            <left>128</left><top>706</top><width>556</width><height>48</height>
            <font>font13</font>
            <textcolor>FFB8C2CE</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label>Apunta con la cámara del móvil</label>
        </control>

        <!-- The address, big enough to be copied by hand from the sofa -->
        <control type="label">
            <left>740</left><top>190</top><width>1084</width><height>44</height>
            <font>font13</font>
            <textcolor>FF8A97A5</textcolor>
            <label>O escribe esta dirección en el navegador del móvil</label>
        </control>
        <control type="image">
            <left>740</left><top>244</top><width>1084</width><height>96</height>
            <texture border="18" colordiffuse="26D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texture>
        </control>
        <control type="label">
            <left>776</left><top>244</top><width>1012</width><height>96</height>
            <font>font36_title</font>
            <textcolor>FFFFB70F</textcolor>
            <aligny>center</aligny>
            <label>$INFO[Window.Property(w_url)]</label>
        </control>

        <control type="textbox">
            <left>740</left><top>372</top><width>1084</width><height>376</height>
            <font>font13</font>
            <textcolor>FFD8DDE3</textcolor>
            <label>$INFO[Window.Property(w_texto)]</label>
        </control>

        <control type="button" id="101">
            <left>740</left><top>782</top><width>528</width><height>72</height>
            <font>font13</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <label>Abrir aquí en el navegador</label>
            <texturefocus border="18" colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturefocus>
            <texturenofocus border="18" colordiffuse="14FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturenofocus>
            <onup>100</onup>
            <ondown>102</ondown>
            <onleft>101</onleft>
            <onright>100</onright>
        </control>
        <control type="button" id="102">
            <left>740</left><top>866</top><width>528</width><height>72</height>
            <font>font13</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFB8C2CE</textcolor>
            <focusedcolor>FFE06C5A</focusedcolor>
            <label>Apagar el servidor</label>
            <texturefocus border="18" colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturefocus>
            <texturenofocus border="18" colordiffuse="14FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturenofocus>
            <onup>101</onup>
            <ondown>102</ondown>
            <onleft>102</onleft>
            <onright>100</onright>
        </control>

        <control type="image">
            <left>0</left><top>968</top><width>1920</width><height>2</height>
            <texture colordiffuse="33D9A520">special://home/addons/script.module.horus/resources/media/white.png</texture>
        </control>
        <control type="label">
            <left>96</left><top>986</top><width>1728</width><height>44</height>
            <font>font12</font>
            <textcolor>FF8A97A5</textcolor>
            <aligny>center</aligny>
            <label>$INFO[Window.Property(w_pie)]</label>
        </control>

        <!-- The X goes last on purpose: if Kodi could not focus the default control,
             the focus is taken by the first one that does accept it. -->
        <control type="button" id="100">
            <left>1740</left><top>22</top><width>84</width><height>60</height>
            <font>font32</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FF8A97A5</textcolor>
            <focusedcolor>FFFFB70F</focusedcolor>
            <label>X</label>
            <texturefocus border="18" colordiffuse="66D9A520">special://home/addons/script.module.horus/resources/media/pill.png</texturefocus>
            <texturenofocus border="18" colordiffuse="14FFFFFF">special://home/addons/script.module.horus/resources/media/pill.png</texturenofocus>
            <onup>100</onup>
            <ondown>101</ondown>
            <onleft>101</onleft>
            <onright>100</onright>
        </control>

    </controls>
</window>
